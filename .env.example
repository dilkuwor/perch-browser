APP_PASSWORD=password
APP_USER=admin
HOST=0.0.0.0
PORT=8080
HOME_URL=https://www.google.com/
CHROME_PATH=
CHROME_NO_SANDBOX=0
CHROME_HEADLESS=1
CHROME_USER_DATA=
# 20-95. Lower = less bandwidth, faster on slow links. Default 60.
JPEG_QUALITY=60
# Sound. 0 disables audio capture entirely. Needs PulseAudio (or PipeWire's Pulse
# server) and ffmpeg on the home server; the Docker image includes both.
AUDIO=1
# PulseAudio source ffmpeg records. The Docker image creates a null sink named
# "perch", so its monitor is the default. Natively, create one with
#   pactl load-module module-null-sink sink_name=perch
# or use @DEFAULT_MONITOR@ to stream whatever the server's default output plays.
AUDIO_SOURCE=perch.monitor
# Opus bitrate in kbit/s (24-256). Only used by browsers with WebCodecs Opus support.
AUDIO_BITRATE=96
